# Copy to .env for local development. Never commit real credentials.
# Generate a long random secret for production identity signatures.
AUTH_SECRET=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=whisper-1
GEMINI_MODEL=gemini-2.5-flash
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
DB_PATH=./ubiquity.db
# Demo mode is enabled by default for hackathon presentations; set false in production.
# Demo mode accepts X-User-Id identities and exposes development OTPs in responses.
DEMO_MODE=true
