# Use the deployed backend URL in production, or leave the local default for development.
VITE_API_BASE_URL=http://localhost:8000
# Replace this demo identity with the authenticated user's stable ID in production.
VITE_USER_ID=demo-customer
# HMAC signature generated by the authenticated backend/session layer in production.
VITE_USER_SIGNATURE=
# Configure the customer’s permitted location, or replace with a live location provider.
VITE_CUSTOMER_LAT=11.0168
VITE_CUSTOMER_LNG=76.9558
